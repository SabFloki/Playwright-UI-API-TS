{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "outDir": "dist",
    "types": ["node", "playwright"]
  },
  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts",
    "env.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
